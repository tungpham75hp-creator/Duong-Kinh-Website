<svg viewBox="0 0 400 260" role="img" aria-label="Minh họa <%= id %>" class="prod-art">
  <defs>
    <linearGradient id="ps-<%= id %>" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#a9d3ee"/><stop offset="1" stop-color="#f4ecd8"/>
    </linearGradient>
  </defs>
  <rect width="400" height="260" fill="url(#ps-<%= id %>)"/>
  <ellipse cx="320" cy="48" rx="34" ry="9" fill="#fff" opacity=".7"/><ellipse cx="90" cy="64" rx="44" ry="10" fill="#fff" opacity=".6"/>
  <circle cx="352" cy="40" r="16" fill="#ffe29a"/>
  <rect y="208" width="400" height="52" fill="#8fbf7a"/>
  <rect y="236" width="400" height="24" fill="#6fa35f"/>

<% if (id === 'bietthu') { %>
  <!-- Biệt thự: mái ngói, ban công, cây, hồ -->
  <path d="M0 232 q100 -14 200 0 t200 0 V260 H0Z" fill="#6fb3dd" opacity=".85"/>
  <rect x="70" y="120" width="190" height="88" fill="#f6efe0"/>
  <rect x="140" y="92" width="120" height="56" fill="#efe6d1"/>
  <polygon points="58,122 165,70 272,122" fill="#9c4a2f"/>
  <polygon points="130,94 200,56 270,94" fill="#b25c3c"/>
  <rect x="88" y="144" width="34" height="42" fill="#7fa6cf"/><rect x="138" y="164" width="40" height="44" fill="#7a4a2e"/>
  <rect x="196" y="150" width="40" height="30" fill="#7fa6cf"/>
  <rect x="150" y="108" width="44" height="26" fill="#7fa6cf"/>
  <rect x="82" y="140" width="46" height="5" fill="#c9a24b"/>
  <path d="M290 208 v-60" stroke="#6b4a2a" stroke-width="7"/><circle cx="290" cy="130" r="36" fill="#3f8a4a"/><circle cx="268" cy="150" r="22" fill="#4f9a58"/>
  <path d="M40 208 v-34" stroke="#6b4a2a" stroke-width="5"/><circle cx="40" cy="166" r="20" fill="#4f9a58"/>
  <rect x="120" y="208" width="60" height="6" fill="#d8cfb7"/>

<% } else if (id === 'lienke') { %>
  <!-- Dãy nhà liền kề nhiều màu -->
  <% const cols = ['#f2d9a8','#e7a98c','#cfe0c8','#b9cdea','#f2c9c9']; %>
  <% cols.forEach(function(c, i) { const x = 24 + i * 70; const h = 100 + (i % 2) * 14; %>
    <rect x="<%= x %>" y="<%= 208 - h %>" width="68" height="<%= h %>" fill="<%= c %>" stroke="#fff" stroke-width="2"/>
    <polygon points="<%= x - 3 %>,<%= 210 - h %> <%= x + 34 %>,<%= 178 - h %> <%= x + 71 %>,<%= 210 - h %>" fill="#8a4b36"/>
    <rect x="<%= x + 9 %>" y="<%= 208 - h + 18 %>" width="20" height="22" fill="#7fa6cf"/><rect x="<%= x + 39 %>" y="<%= 208 - h + 18 %>" width="20" height="22" fill="#7fa6cf"/>
    <rect x="<%= x + 9 %>" y="<%= 208 - h + 52 %>" width="20" height="22" fill="#7fa6cf"/>
    <rect x="<%= x + 39 %>" y="<%= 208 - 36 %>" width="20" height="36" fill="#6b4a2a"/>
  <% }) %>
  <g fill="#3f8a4a"><circle cx="16" cy="200" r="12"/><circle cx="388" cy="200" r="12"/></g>
  <rect y="214" width="400" height="10" fill="#cfcabc"/>

<% } else if (id === 'shophouse') { %>
  <!-- Shophouse: tầng trệt kinh doanh có mái hiên -->
  <% const sc = ['#f3d6c3','#d6e4ef','#f1e4a9','#e6cfe3']; const aw = ['#c4623a','#2f7f79','#c9a24b','#7a5bb0']; %>
  <% sc.forEach(function(c, i) { const x = 22 + i * 90; %>
    <rect x="<%= x %>" y="84" width="88" height="124" fill="<%= c %>" stroke="#fff" stroke-width="2"/>
    <rect x="<%= x + 10 %>" y="98" width="30" height="26" fill="#7fa6cf"/><rect x="<%= x + 48 %>" y="98" width="30" height="26" fill="#7fa6cf"/>
    <rect x="<%= x + 8 %>" y="138" width="72" height="14" fill="<%= aw[i] %>"/>
    <path d="M<%= x + 8 %> 152 h72 l-6 8 h-60z" fill="<%= aw[i] %>" opacity=".7"/>
    <rect x="<%= x + 12 %>" y="162" width="64" height="46" fill="#fffbe9"/>
    <rect x="<%= x + 18 %>" y="168" width="22" height="40" fill="#9fc3df"/><rect x="<%= x + 48 %>" y="168" width="22" height="40" fill="#9fc3df"/>
  <% }) %>
  <rect x="22" y="76" width="356" height="10" fill="#10264f"/>
  <rect y="208" width="400" height="14" fill="#9aa0a6"/><path d="M0 215 H400" stroke="#fff" stroke-dasharray="14 10"/>
  <g fill="#3f8a4a"><circle cx="12" cy="200" r="10"/><circle cx="392" cy="200" r="10"/></g>

<% } else { %>
  <!-- Chung cư cao tầng -->
  <rect x="60" y="44" width="76" height="164" fill="#3d5aa0"/>
  <rect x="150" y="20" width="96" height="188" fill="#4b6cb7"/>
  <rect x="260" y="64" width="78" height="144" fill="#3d5aa0"/>
  <% [[60,76,10],[150,96,12],[260,78,10]].forEach(function(b){ for (let r = 0; r < 11; r++) { for (let c = 0; c < b[2]/2 - 1 + 2; c++) { const wx = b[0] + 8 + c * (b[1] - 16) / (b[2]/2); const wy = (b[0] === 150 ? 30 : b[0] === 60 ? 54 : 74) + r * 15; if (wy > 196) continue; %>
    <rect x="<%= wx.toFixed(1) %>" y="<%= wy %>" width="9" height="8" fill="<%= (r + c) % 3 === 0 ? '#ffe6a3' : '#a9c1ea' %>"/>
  <% } } }) %>
  <rect x="190" y="180" width="16" height="28" fill="#10264f"/>
  <rect x="146" y="14" width="104" height="8" fill="#2f4d92"/>
  <g fill="#3f8a4a"><circle cx="40" cy="198" r="14"/><circle cx="352" cy="198" r="14"/><circle cx="372" cy="204" r="10"/></g>
<% } %>
</svg>

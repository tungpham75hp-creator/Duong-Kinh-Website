<svg class="hero-art" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMax slice" role="img" aria-label="Phối cảnh minh họa khu đô thị ven hồ lúc hoàng hôn">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#0d1b3d"/>
      <stop offset=".45" stop-color="#3b3f7a"/>
      <stop offset=".75" stop-color="#e0856b"/>
      <stop offset="1" stop-color="#f6c47b"/>
    </linearGradient>
    <linearGradient id="lake" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e9a56f"/>
      <stop offset=".5" stop-color="#5a6aa0"/>
      <stop offset="1" stop-color="#1c2a55"/>
    </linearGradient>
    <linearGradient id="glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8fa9d8"/>
      <stop offset="1" stop-color="#34487c"/>
    </linearGradient>
    <radialGradient id="sun" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#fff3c4"/>
      <stop offset=".4" stop-color="#ffd27a" stop-opacity=".9"/>
      <stop offset="1" stop-color="#ffb35c" stop-opacity="0"/>
    </radialGradient>
    <pattern id="win" width="10" height="14" patternUnits="userSpaceOnUse">
      <rect width="10" height="14" fill="none"/>
      <rect x="2" y="3" width="5" height="7" fill="#ffe6a3" opacity=".85"/>
    </pattern>
  </defs>

  <rect width="1440" height="700" fill="url(#sky)"/>
  <g class="stars" fill="#fff">
    <circle cx="120" cy="70" r="1.6"/><circle cx="310" cy="130" r="1.2"/><circle cx="540" cy="60" r="1.5"/>
    <circle cx="760" cy="110" r="1.1"/><circle cx="980" cy="50" r="1.6"/><circle cx="1180" cy="120" r="1.3"/>
    <circle cx="1320" cy="70" r="1.5"/><circle cx="660" cy="170" r="1"/><circle cx="220" cy="210" r="1"/>
  </g>
  <circle cx="1010" cy="430" r="190" fill="url(#sun)"/>
  <circle cx="1010" cy="430" r="62" fill="#fff0bd"/>

  <g class="cloud cloud-a" fill="#ffd9b8" opacity=".55">
    <ellipse cx="260" cy="300" rx="120" ry="16"/><ellipse cx="330" cy="288" rx="80" ry="14"/>
  </g>
  <g class="cloud cloud-b" fill="#ffd9b8" opacity=".4">
    <ellipse cx="1180" cy="250" rx="140" ry="15"/><ellipse cx="1110" cy="238" rx="70" ry="12"/>
  </g>

  <!-- Đường chân trời xa: núi/đồi Đồ Sơn -->
  <path d="M0 470 Q120 420 240 455 T470 450 T700 470 L700 500 L0 500Z" fill="#4a3f73" opacity=".7"/>

  <!-- Tòa nhà cao tầng nền sau -->
  <g fill="#27346a" opacity=".92">
    <rect x="150" y="300" width="70" height="200"/><rect x="230" y="340" width="55" height="160"/>
    <rect x="300" y="270" width="64" height="230"/><rect x="380" y="330" width="60" height="170"/>
    <polygon points="470,500 470,290 505,250 540,290 540,500"/>
    <rect x="560" y="320" width="70" height="180"/>
  </g>
  <g fill="url(#win)" opacity=".7">
    <rect x="150" y="300" width="70" height="200"/><rect x="300" y="270" width="64" height="230"/>
    <rect x="470" y="290" width="70" height="210"/><rect x="560" y="320" width="70" height="180"/>
  </g>

  <!-- Tháp chủ đạo -->
  <g>
    <rect x="780" y="190" width="90" height="320" fill="url(#glass)"/>
    <rect x="780" y="190" width="90" height="320" fill="url(#win)" opacity=".55"/>
    <rect x="880" y="250" width="70" height="260" fill="#2c3f75"/>
    <rect x="880" y="250" width="70" height="260" fill="url(#win)" opacity=".55"/>
    <rect x="690" y="270" width="80" height="240" fill="#32467f"/>
    <rect x="690" y="270" width="80" height="240" fill="url(#win)" opacity=".5"/>
    <rect x="825" y="165" width="4" height="28" fill="#ffe0a0"/>
  </g>

  <!-- Dải nhà liền kề / biệt thự -->
  <g>
    <g fill="#1b2650">
      <polygon points="0,520 0,470 60,440 120,470 120,520"/>
      <polygon points="120,520 120,478 180,450 240,478 240,520"/>
      <polygon points="1040,520 1040,470 1100,440 1160,470 1160,520"/>
      <polygon points="1160,520 1160,478 1220,452 1280,478 1280,520"/>
      <polygon points="1280,520 1280,466 1340,436 1400,466 1400,520"/>
      <polygon points="1400,520 1400,478 1440,458 1440,520"/>
    </g>
    <g fill="#ffe6a3" opacity=".85">
      <rect x="20" y="485" width="18" height="16"/><rect x="82" y="485" width="18" height="16"/>
      <rect x="140" y="490" width="18" height="16"/><rect x="202" y="490" width="18" height="16"/>
      <rect x="1060" y="485" width="18" height="16"/><rect x="1122" y="485" width="18" height="16"/>
      <rect x="1180" y="490" width="18" height="16"/><rect x="1242" y="490" width="18" height="16"/>
      <rect x="1300" y="482" width="18" height="16"/><rect x="1362" y="482" width="18" height="16"/>
    </g>
  </g>

  <!-- Hàng cây ven hồ -->
  <g fill="#14331f">
    <circle cx="640" cy="505" r="26"/><circle cx="670" cy="512" r="20"/><circle cx="610" cy="512" r="18"/>
    <circle cx="980" cy="508" r="24"/><circle cx="1010" cy="514" r="18"/>
    <circle cx="300" cy="512" r="22"/><circle cx="270" cy="518" r="16"/>
  </g>
  <rect x="0" y="518" width="1440" height="14" fill="#10281a"/>

  <!-- Mặt hồ + phản chiếu -->
  <rect x="0" y="532" width="1440" height="168" fill="url(#lake)"/>
  <g opacity=".35">
    <rect x="780" y="535" width="90" height="120" fill="#8fa9d8" transform="translate(0 0)"/>
    <rect x="880" y="535" width="70" height="90" fill="#6d84b8"/>
    <rect x="690" y="535" width="80" height="80" fill="#6d84b8"/>
  </g>
  <ellipse cx="1010" cy="560" rx="60" ry="6" fill="#fff0bd" opacity=".7"/>
  <ellipse cx="1010" cy="588" rx="90" ry="5" fill="#ffd27a" opacity=".45"/>
  <ellipse cx="1010" cy="620" rx="40" ry="4" fill="#ffd27a" opacity=".3"/>
  <g class="ripples" fill="none" stroke="#fff" stroke-opacity=".25">
    <path d="M100 600 q40 -8 80 0 t80 0"/><path d="M420 640 q40 -8 80 0 t80 0"/><path d="M1180 610 q40 -8 80 0 t80 0"/>
  </g>

  <!-- Chim -->
  <g class="birds" stroke="#1b2650" stroke-width="2" fill="none" stroke-linecap="round">
    <path d="M560 150 q8 -9 16 0 q8 -9 16 0"/>
    <path d="M610 180 q6 -7 12 0 q6 -7 12 0"/>
    <path d="M520 190 q5 -6 10 0 q5 -6 10 0"/>
  </g>
</svg>

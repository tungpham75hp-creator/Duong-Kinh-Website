<svg id="masterplan" viewBox="0 0 900 580" role="img" aria-label="Sơ đồ phân khu chức năng minh họa của khu đô thị">
  <defs>
    <pattern id="pat-lienke" width="16" height="12" patternUnits="userSpaceOnUse">
      <rect width="16" height="12" fill="#d7ece8"/>
      <rect x="2" y="2" width="12" height="8" rx="1" fill="#2f7f79"/>
    </pattern>
    <pattern id="pat-bietthu" width="26" height="22" patternUnits="userSpaceOnUse">
      <rect width="26" height="22" fill="#f6ecd3"/>
      <rect x="4" y="4" width="18" height="14" rx="3" fill="#c9a24b"/>
      <circle cx="13" cy="11" r="2.5" fill="#f6ecd3"/>
    </pattern>
    <pattern id="pat-noxh" width="18" height="18" patternUnits="userSpaceOnUse">
      <rect width="18" height="18" fill="#dfe6f6"/>
      <rect x="3" y="2" width="12" height="14" fill="#4b6cb7"/>
    </pattern>
    <pattern id="pat-shop" width="14" height="14" patternUnits="userSpaceOnUse">
      <rect width="14" height="14" fill="#f7e0d5"/>
      <rect x="1.5" y="3" width="11" height="8" fill="#c4623a"/>
    </pattern>
    <linearGradient id="water" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#8fc6e8"/><stop offset="1" stop-color="#4f93c4"/>
    </linearGradient>
    <filter id="soft" x="-5%" y="-5%" width="110%" height="110%"><feDropShadow dx="0" dy="3" stdDeviation="4" flood-opacity=".18"/></filter>
  </defs>

  <!-- Nền ngoài ranh dự án -->
  <rect width="900" height="580" fill="#eef2ea"/>
  <!-- Ranh giới dự án -->
  <path id="site" d="M60 120 C120 50 300 30 480 50 C650 60 800 90 850 190 C890 280 860 400 790 470 C700 540 520 545 380 520 C230 495 110 470 70 380 C35 300 30 180 60 120Z"
        fill="#cfe4c2" stroke="#7aa06a" stroke-width="3" stroke-dasharray="10 6" filter="url(#soft)"/>

  <!-- Hồ trung tâm -->
  <path class="water" d="M470 290 C480 230 580 215 650 240 C720 265 730 330 670 365 C610 400 500 380 470 330Z" fill="url(#water)" stroke="#3d7fb0" stroke-width="2"/>
  <path d="M540 285 q30 -10 60 0 M560 310 q30 -10 60 0 M520 330 q25 -8 50 0" stroke="#fff" stroke-opacity=".55" fill="none" stroke-width="2"/>
  <!-- Đảo công viên -->
  <ellipse cx="590" cy="300" rx="26" ry="16" fill="#8fc27a" stroke="#5f9a4e"/>

  <!-- ====== Các phân khu ====== -->
  <g class="zone" data-zone="noxh" tabindex="0">
    <polygon points="100,140 240,112 262,200 122,228" fill="url(#pat-noxh)" stroke="#4b6cb7" stroke-width="2"/>
    <g fill="#2f4d92"><rect x="130" y="150" width="14" height="38"/><rect x="156" y="144" width="14" height="48"/><rect x="182" y="140" width="14" height="52"/><rect x="208" y="136" width="14" height="46"/></g>
  </g>

  <g class="zone" data-zone="giaoduc" tabindex="0">
    <polygon points="280,100 392,92 398,176 288,184" fill="#e9dff4" stroke="#7a5bb0" stroke-width="2"/>
    <rect x="300" y="115" width="70" height="30" rx="3" fill="#7a5bb0"/><rect x="340" y="150" width="30" height="16" fill="#9b80c9"/>
  </g>

  <g class="zone" data-zone="yte" tabindex="0">
    <polygon points="408,96 470,98 474,172 412,172" fill="#fbe0e0" stroke="#d1495b" stroke-width="2"/>
    <rect x="428" y="116" width="32" height="32" fill="#d1495b"/><path d="M444 122v20M434 132h20" stroke="#fff" stroke-width="4"/>
  </g>

  <g class="zone" data-zone="thuongmai" tabindex="0">
    <polygon points="300,246 452,240 456,320 304,326" fill="url(#pat-shop)" stroke="#c4623a" stroke-width="2"/>
    <text x="378" y="288" text-anchor="middle" class="zl" fill="#7a2f14" stroke="#fff" stroke-width="4" paint-order="stroke">PHỐ THƯƠNG MẠI</text>
  </g>

  <g class="zone" data-zone="lienke" tabindex="0">
    <polygon points="80,246 288,246 292,330 82,336" fill="url(#pat-lienke)" stroke="#2f7f79" stroke-width="2"/>
    <polygon points="86,372 440,358 448,470 120,452 92,420" fill="url(#pat-lienke)" stroke="#2f7f79" stroke-width="2"/>
  </g>

  <g class="zone" data-zone="bietthu" tabindex="0">
    <polygon points="490,68 790,96 830,186 700,214 520,205 482,190" fill="url(#pat-bietthu)" stroke="#a8812c" stroke-width="2"/>
    <polygon points="502,404 770,420 742,490 560,506 506,470" fill="url(#pat-bietthu)" stroke="#a8812c" stroke-width="2"/>
    <polygon points="740,250 836,260 842,360 760,376 744,320" fill="url(#pat-bietthu)" stroke="#a8812c" stroke-width="2"/>
  </g>

  <g class="zone" data-zone="congvien" tabindex="0">
    <path d="M450 270 C440 200 560 190 660 215 C740 240 760 330 690 385 C620 430 480 410 450 340Z" fill="none" stroke="#5f9a4e" stroke-width="14" stroke-opacity=".55" stroke-linejoin="round"/>
    <circle cx="640" cy="215" r="9" fill="#5f9a4e"/><circle cx="500" cy="400" r="9" fill="#5f9a4e"/><circle cx="458" cy="300" r="9" fill="#5f9a4e"/>
  </g>

  <!-- Trục đường chính -->
  <path d="M42 338 C200 340 330 336 456 334 C560 330 700 440 862 410" fill="none" stroke="#fff" stroke-width="16" stroke-linecap="round"/>
  <path d="M42 338 C200 340 330 336 456 334 C560 330 700 440 862 410" fill="none" stroke="#c7ccc2" stroke-width="2" stroke-dasharray="12 10"/>
  <!-- Đường nhánh -->
  <g fill="none" stroke="#fff" stroke-width="8" stroke-linecap="round">
    <path d="M296 80 V490"/><path d="M60 236 H480"/><path d="M470 60 V200"/><path d="M700 214 V470"/>
  </g>

  <!-- Cổng chính -->
  <g>
    <circle cx="44" cy="338" r="14" fill="#10264f"/><text x="44" y="343" text-anchor="middle" fill="#fff" font-size="12" font-weight="700">C</text>
  </g>
  <!-- La bàn -->
  <g transform="translate(850 70)">
    <circle r="24" fill="#fff" stroke="#10264f"/><path d="M0 -18 L6 6 L0 2 L-6 6Z" fill="#c4623a"/><text y="-28" text-anchor="middle" font-size="12" font-weight="700" fill="#10264f">B</text>
  </g>
  <text x="140" y="548" class="zl" fill="#4d5a40">Ranh giới dự án ≈ 240,6 ha (minh họa, không theo tỷ lệ)</text>
</svg>
